{
    "name": "remymazmanian/qr-studio",
    "description": "Framework-agnostic PHP library for generating styled QR codes as SVG or PNG, with module, eye and frame styles, centre logos and captions.",
    "type": "library",
    "keywords": [
        "qr",
        "qrcode",
        "svg",
        "png",
        "generator",
        "vcard",
        "wifi"
    ],
    "homepage": "https://remymazmanian.com/qr-studio/",
    "license": "MIT",
    "authors": [
        {
            "name": "Remy Mazmanian",
            "role": "Author"
        }
    ],
    "support": {
        "issues": "https://github.com/remymazmanian/qr-studio/issues",
        "source": "https://github.com/remymazmanian/qr-studio",
        "security": "https://github.com/remymazmanian/qr-studio/security/policy"
    },
    "require": {
        "php": "^8.4",
        "endroid/qr-code": "^6.1"
    },
    "require-dev": {
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "suggest": {
        "ext-gd": "Required for PNG output; SVG output works without it"
    },
    "autoload": {
        "psr-4": {
            "QrStudio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QrStudio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "demo": "php -S localhost:8080 -t demo"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
